<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="home_bg">#FF0A0C0F</color>
    <style name="HomeTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/home_bg</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
    <style name="ControlCenterTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
